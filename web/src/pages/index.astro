---
import '../styles/global.css';
import Hero from '../components/Hero.astro';
import Kpis from '../components/Kpis.astro';
import ReversalChart from '../components/ReversalChart.astro';
import RecentReversals from '../components/RecentReversals.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="The open trade reversal database. Check if a Steam ID has a history of reversed trades, reported by marketplaces, trading tools, and community platforms.">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='16' r='14' fill='%231d9bf0'/><ellipse cx='16' cy='16' rx='10' ry='7' fill='%230f1419'/><circle cx='16' cy='16' r='4' fill='%23e7e9ea'/></svg>" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" />
    <title>reverse.watch — The open trade reversal database</title>
</head>
<body>
    <main class="container">
        <Hero />
        <Kpis />
        <ReversalChart />
        <RecentReversals />
    </main>

    <SiteFooter />

    <script>
        import '../scripts/app.ts';
    </script>
</body>
</html>
